# JobPulse Backend Configuration

# Database
DATABASE_URL=sqlite:///./data/jobpulse.db

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Job Data Sources
# Add API keys for job data sources here
# ADZUNA_APP_ID=your_app_id
# ADZUNA_API_KEY=your_api_key

# LLM Configuration (optional, for Stage 2 skill extraction)
# OPENAI_API_KEY=your_openai_key
# LLM_MODEL=gpt-4o-mini
# LLM_ENABLED=false

# Scheduling
COLLECTION_SCHEDULE=daily
# Options: daily, weekly, manual

# Logging
LOG_LEVEL=INFO
